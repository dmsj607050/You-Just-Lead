{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "You Just Lead",
  "version": "0.1.9",
  "identifier": "com.youjustlead.competitionagent",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "You Just Lead · Competition Training Agent",
      "width": 1440,
      "height": 960,
      "minWidth": 1120,
      "minHeight": 720,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "externalBin": ["binaries/competition-agent-api"]
  }
}
