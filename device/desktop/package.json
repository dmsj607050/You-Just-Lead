{
  "name": "you-just-lead-competition-intelligence",
  "version": "0.1.9",
  "private": true,
  "description": "Evidence-led competition intelligence dashboard for machine learning research workflows.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "desktop:dev": "vite --config vite.desktop.config.ts",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:sidecar": "powershell -ExecutionPolicy Bypass -File ./tools/build_desktop_sidecar.ps1",
    "desktop:package": "powershell -ExecutionPolicy Bypass -File ./tools/package_windows_installer.ps1",
    "tauri": "tauri",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "@tauri-apps/api": "^2.8.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tauri-apps/cli": "^2.8.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
